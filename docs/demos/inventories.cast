[6.383, "o", "\u001b[>4m\u001b[?1049h\u001b[?25l\u001b[?5W\u001b[?2004h\u001b[>4;2m\u001b[>1u\u001b[?u\u001b[H\u001b[2J\u001b[1mwtc secrets \u00b7 add-search\u001b[m\r\n\u001b[2m3 file paths \u00b7 shared means available to collections with that repository\u001b[m\r\n\u001b[1m  PATH\u001b[55X\u001b[3;62HSCOPE     STATE\u001b[m\r\n\u001b[7m\u203a .env.collection.local                                      local     present          \u001b[m\r\n  api/.env\u001b[51X\u001b[5;62Hshared    linked\r\n  web/.env\u001b[51X\u001b[6;62Hshared    linked\r\u001b[7B\u001b[1m.env.collection.local\u001b[m\r\n\u001b[2mstate: present \u00b7 scope: this collection (local secret variables)\u001b[m\r\n\u001b[2mtarget: all worktrees in this collection \u00b7 gitignored: unknown\u001b[m\r\n\u001b[2m1/3 \u00b7 \u2191\u2193 select \u00b7 PgUp/PgDn page \u00b7 q quit\u001b[m"]
